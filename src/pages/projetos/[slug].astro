---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/era.css';
import Foto from '../../components/midia/Foto.astro';
import Moldura from '../../components/era/Moldura.astro';
import Selo from '../../components/era/Selo.astro';
import Navegacao from '../../components/era/Navegacao.astro';
import { site, mensagemWhatsapp } from '../../config/site';
import { linkWhatsapp } from '../../lib/whatsapp';
import { fichaTrilha } from '../../lib/seo';
import Motor from '../../components/era/Motor.astro';

export async function getStaticPaths() {
  const obras = await getCollection('projetos');
  return obras.map((obra) => ({
    params: { slug: obra.id },
    props: { obra },
  }));
}

const { obra } = Astro.props;
const {
  titulo,
  local,
  ano,
  area,
  descricao,
  categoria,
  materiais,
  capa,
  altCapa,
  galeria,
  plantas,
  fonte,
  ordem,
} = obra.data;
const urlSite = Astro.site?.href.replace(/\/$/, '') ?? '';
const whatsapp = linkWhatsapp(mensagemWhatsapp);
const num = String(ordem).padStart(2, '0');

/* título display da referência: o tamanho acompanha o comprimento para
   nunca invadir o nav fixo no canto superior direito */
const classeTitulo = titulo.length > 20 ? 'e-t-4' : titulo.length > 10 ? 'e-t-3' : 'e-t-1';

/* a última foto vira a faixa full-bleed de materiais (sem repetir imagem) */
const fotos = galeria.slice(0, -1);
const faixa = galeria[galeria.length - 1];

const outros = (await getCollection('projetos'))
  .filter((o) => o.id !== obra.id)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 3);
---

<Base
  titulo={`${titulo} | ${site.nome}`}
  descricao={descricao}
  cabecalho="mobile"
  estruturados={[
    fichaTrilha([
      { nome: 'Início', url: urlSite },
      { nome: 'Projetos', url: `${urlSite}/projetos` },
      { nome: titulo, url: `${urlSite}/projetos/${obra.id}` },
    ]),
  ]}
>
  <div class="pagina-era e-det">
    <header class="e-det-topo">
      <h1 class={`${classeTitulo} e-det-h1`} data-entrada>{titulo}</h1>
      <div class="e-det-linhas" data-entrada style="--atraso:120ms">
        <p class="e-l1">{categoria}</p>
        <p class="e-l1 e-det-linha-fraca">Conclusão: {ano}</p>
      </div>
    </header>

    <div class="e-det-grade">
      <div class="e-det-media">
        <figure class="e-det-capa e-foto" data-foto data-entrada style="--atraso:200ms">
          <Foto src={capa} alt={altCapa} sizes="(min-width: 1024px) 56vw, 100vw" prioridade />
        </figure>

        <div class="e-det-galeria">
          {
            fotos.map((imagem, indice) => (
              <figure class="e-det-foto" data-entrada style={`--atraso:${280 + indice * 80}ms`}>
                <Foto
                  src={imagem}
                  alt={`${titulo} — foto ${indice + 1}`}
                  sizes="(min-width: 1024px) 56vw, 100vw"
                />
              </figure>
            ))
          }
        </div>

        {
          plantas.length > 0 && (
            <section class="e-det-plantas" data-entrada>
              <h2 class="e-l1">Plantas</h2>
              <ul class="e-det-plantas-grade">
                {plantas.map((planta, indice) => (
                  <li class="e-det-planta">
                    <Foto
                      src={planta}
                      alt={`Planta ${indice + 1} — ${titulo}`}
                      sizes="(min-width: 768px) 28vw, 90vw"
                      classe="object-contain"
                    />
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="e-det-painel" data-entrada style="--atraso:340ms">
        <dl class="e-det-ficha">
          <div class="e-det-par">
            <dt class="e-l2">Área</dt>
            <dd class="e-t-5">{area} m²</dd>
          </div>
          <div class="e-det-par">
            <dt class="e-l2">Local</dt>
            <dd class="e-t-5">{local}</dd>
          </div>
        </dl>

        <div class="e-det-info">
          <p class="e-l2 e-det-info-rot">Info</p>
          <p class="e-p1 e-det-desc">{descricao}</p>
        </div>

        <div class="e-det-acoes">
          <a class="e-det-btn e-det-btn--solida" href={whatsapp} target="_blank" rel="noopener">
            WhatsApp
          </a>
          <a class="e-det-btn" href="/projetos">Ver todos</a>
        </div>

        <p class="e-l2 e-det-fonte">
          Fonte:
          <a href={fonte.url} target="_blank" rel="noopener">{fonte.nome}</a>
        </p>
      </aside>
    </div>

    <figure class="e-det-faixa" data-entrada>
      <Foto src={faixa} alt={`${titulo} — detalhe de materiais`} sizes="100vw" />
      <span class="e-det-faixa-veu" aria-hidden="true"></span>
      <figcaption class="e-det-faixa-lista">
        <span class="e-l2">Materiais</span>
        <ul>
          {materiais.map((material) => <li class="e-t-5">{material}</li>)}
        </ul>
      </figcaption>
    </figure>

    {
      outros.length > 0 && (
        <section class="e-det-outros">
          <p class="e-l1 e-det-outros-rot" data-entrada>
            Continue explorando
          </p>
          <h2 class="e-t-4 e-det-outros-tit" data-entrada style="--atraso:80ms">
            Outros projetos
          </h2>
          <ul class="e-outros-grade">
            {outros.map((o, i) => {
              const d = o.data;
              const n = String(d.ordem).padStart(2, '0');
              return (
                <li class="e-outro" data-entrada style={`--atraso:${160 + i * 70}ms`}>
                  <a class="e-outro-link" href={`/projetos/${o.id}`}>
                    <span class="e-outro-topo">
                      <span class="e-l1">{d.categoria}</span>
                      <span class="e-l1 e-outro-ano">{d.ano}</span>
                    </span>
                    <span class="e-outro-foto">
                      <Foto
                        src={d.capa}
                        alt={d.altCapa}
                        sizes="(min-width: 1024px) 28vw, (min-width: 768px) 45vw, 90vw"
                      />
                    </span>
                    <span class="e-outro-dados">
                      <span class="e-l1">№{n} · {d.local}</span>
                      <span class="e-t-5 e-outro-titulo">{d.titulo}</span>
                      <span class="e-l1">{d.area} m²</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
          <p class="e-det-ver" data-entrada>
            <a class="e-det-btn" href="/projetos">Ver todos os projetos</a>
          </p>
        </section>
      )
    }

    <section id="contato" class="e-det-convite" data-entrada>
      <p class="e-p1 e-det-convite-lid">
        Uma conversa curta basta para entender seu terreno, seu programa e o seu jeito de viver.
      </p>
      <h2 class="e-t-3">Vamos conversar</h2>
      <a class="e-det-btn e-det-btn--solida" href={whatsapp} target="_blank" rel="noopener">
        WhatsApp
      </a>
    </section>

    <div class="e-chrome">
      <Moldura />
      <Selo />
      <Navegacao />
      <div class="e-det-rail">
        <span class="e-l1 e-det-rail-atual">№{num}</span>
        <a class="e-l1" href="/projetos">Projetos /</a>
        <a class="e-l1" href="/">Início /</a>
      </div>
    </div>

    <Motor />
  </div>
</Base>

<script>
  /* revelações no scroll, mesmo motor da listagem e da home */
  const alvos = document.querySelectorAll<HTMLElement>('[data-entrada]');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visivel');
            obs.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -6% 0px' },
    );
    alvos.forEach((t) => obs.observe(t));
  } else {
    alvos.forEach((t) => t.classList.add('visivel'));
  }
</script>

<style>
  /* papel quente da referência; mídia e painel por cima */
  .e-det {
    position: relative;
    background: color-mix(in srgb, var(--color-papel) 72%, var(--color-linha));
    padding: 0 calc(var(--cel) * 0.3) 0 calc(var(--cel) * 1.3);
  }

  /* ------------------------------- topo ---------------------------------- */

  .e-det-topo {
    display: grid;
    gap: calc(var(--cel) * 0.16);
    margin-left: calc(var(--cel) * 0.5);
    padding-top: calc(var(--cel) * 1.2);
    /* títulos longos quebram antes de chegar ao nav fixo */
    padding-right: calc(var(--cel) * 1.7);
  }

  .e-det-h1 {
    text-wrap: balance;
  }

  .e-det-linhas {
    display: grid;
    gap: 4px;
  }

  .e-det-linhas p {
    margin: 0;
  }

  .e-det-linha-fraca {
    color: var(--color-cinza);
  }

  /* ------------------------------- grade --------------------------------- */

  .e-det-grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(var(--cel) * 2.99);
    column-gap: calc(var(--cel) * 0.22);
    margin-top: calc(var(--cel) * 0.6);
    align-items: start;
  }

  .e-det-media {
    display: grid;
    gap: calc(var(--cel) * 0.22);
    min-width: 0;
  }

  .e-det-capa {
    margin: 0;
    aspect-ratio: 16 / 9;
  }

  .e-det-galeria {
    display: grid;
    gap: calc(var(--cel) * 0.22);
  }

  .e-det-foto {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: clip;
  }

  /* ------------------------------ plantas -------------------------------- */

  .e-det-plantas {
    display: grid;
    gap: calc(var(--cel) * 0.16);
  }

  .e-det-plantas h2 {
    margin: 0;
  }

  .e-det-plantas-grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .e-det-planta {
    display: flex;
    min-width: 0;
    padding: calc(var(--cel) * 0.24);
    background: var(--color-papel);
    /* cantos chanfrados, como os cartões da referência */
    clip-path: polygon(
      calc(var(--cel) * 0.1) 0,
      calc(100% - var(--cel) * 0.1) 0,
      100% calc(var(--cel) * 0.1),
      100% calc(100% - var(--cel) * 0.1),
      calc(100% - var(--cel) * 0.1) 100%,
      calc(var(--cel) * 0.1) 100%,
      0 calc(100% - var(--cel) * 0.1),
      0 calc(var(--cel) * 0.1)
    );
  }

  .e-det-planta :global(img) {
    height: auto;
    max-height: calc(var(--cel) * 2.4);
    object-fit: contain;
  }

  /* ------------------------------ painel --------------------------------- */

  .e-det-painel {
    position: sticky;
    /* abaixo do nav fixo, como o painel da referência */
    top: calc(clamp(1rem, 3vw, 2.5rem) + 165px);
    align-self: start;
    display: grid;
    justify-items: start;
    gap: calc(var(--cel) * 0.3);
    min-width: 0;
    border-left: 1px solid var(--color-linha);
    padding-left: calc(var(--cel) * 0.12);
  }

  .e-det-ficha {
    display: grid;
    gap: calc(var(--cel) * 0.26);
    margin: 0;
    width: 100%;
  }

  .e-det-par {
    display: grid;
    gap: var(--u-16);
    margin: 0;
  }

  .e-det-par dt {
    color: var(--color-cinza);
  }

  .e-det-par dd {
    margin: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  .e-det-info {
    display: grid;
    gap: calc(var(--cel) * 0.18);
    width: 100%;
  }

  .e-det-info-rot {
    justify-self: start;
    margin: 0;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-tinta);
  }

  .e-det-desc {
    margin: 0;
  }

  .e-det-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
  }

  .e-det-btn {
    display: inline-block;
    padding: 14px 30px;
    border: 1px solid var(--color-tinta);
    border-radius: 999px;
    background: transparent;
    color: var(--color-tinta);
    font-family: var(--corpo);
    font-size: var(--l1);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.45;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.35s var(--curva),
      border-color 0.35s var(--curva),
      color 0.35s var(--curva);
  }

  .e-det-btn:hover {
    background: var(--color-tinta);
    border-color: var(--color-tinta);
    color: var(--color-papel);
  }

  .e-det-btn--solida {
    background: var(--color-tinta);
    color: var(--color-papel);
  }

  .e-det-btn--solida:hover {
    background: var(--color-terracota);
    border-color: var(--color-terracota);
    color: var(--color-papel);
  }

  .e-det-fonte {
    margin: 0;
    color: var(--color-cinza);
  }

  .e-det-fonte a {
    color: var(--color-tinta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .e-det-fonte a:hover {
    color: var(--color-terracota);
  }

  /* --------------------------- faixa de materiais ------------------------ */

  .e-det-faixa {
    position: relative;
    overflow: clip;
    height: clamp(380px, 62vh, 640px);
    margin: calc(var(--cel) * 0.9) calc(var(--cel) * -0.3) 0 calc(var(--cel) * -1.3);
  }

  .e-det-faixa-veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(18 12 8 / 0.34) 0%,
      rgb(18 12 8 / 0.44) 55%,
      rgb(18 12 8 / 0.7) 100%
    );
  }

  /* lista alinhada à coluna do painel: o fio continua a régua vertical */
  .e-det-faixa-lista {
    position: absolute;
    top: 50%;
    left: calc(100% - var(--cel) * 3.29);
    transform: translateY(-50%);
    display: grid;
    justify-items: start;
    gap: var(--u-16);
    padding-left: calc(var(--cel) * 0.18);
    border-left: 1px solid rgb(255 255 255 / 0.55);
    color: var(--color-papel);
  }

  .e-det-faixa-lista ul {
    display: grid;
    gap: var(--u-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .e-det-faixa-lista li {
    text-shadow: 0 1px 14px rgb(18 12 8 / 0.5);
  }

  /* ------------------------------ outros --------------------------------- */

  .e-det-outros {
    margin-top: calc(var(--cel) * 1.2);
    padding-top: calc(var(--cel) * 0.9);
    border-top: 1px solid var(--color-linha);
  }

  .e-det-outros-rot {
    margin: 0;
    color: var(--color-cinza);
  }

  .e-det-outros-tit {
    margin-top: calc(var(--cel) * 0.12);
  }

  .e-outros-grade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    margin: calc(var(--cel) * 0.5) 0 0;
    padding: 0;
    list-style: none;
  }

  .e-outro {
    display: flex;
    min-width: 0;
  }

  .e-outro-link {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--u-32);
    padding: calc(var(--cel) * 0.24);
    background: var(--color-papel);
    color: inherit;
    text-decoration: none;
    /* cantos chanfrados, como os cartões da listagem */
    clip-path: polygon(
      calc(var(--cel) * 0.1) 0,
      calc(100% - var(--cel) * 0.1) 0,
      100% calc(var(--cel) * 0.1),
      100% calc(100% - var(--cel) * 0.1),
      calc(100% - var(--cel) * 0.1) 100%,
      calc(var(--cel) * 0.1) 100%,
      0 calc(100% - var(--cel) * 0.1),
      0 calc(var(--cel) * 0.1)
    );
  }

  .e-outro-topo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    text-align: center;
  }

  .e-outro-ano {
    color: var(--color-cinza);
    font-weight: 500;
  }

  .e-outro-foto {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .e-outro-foto :global(img) {
    transition: transform 0.6s var(--curva);
  }

  .e-outro-link:hover .e-outro-foto :global(img) {
    transform: scale(1.03);
  }

  .e-outro-dados {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--cel) * 0.06);
    margin-top: auto;
    text-align: center;
  }

  .e-outro-titulo {
    text-wrap: balance;
    transition: color 0.35s var(--curva);
  }

  .e-outro-link:hover .e-outro-titulo {
    color: var(--color-terracota);
  }

  .e-det-ver {
    display: flex;
    justify-content: center;
    margin: calc(var(--cel) * 0.6) 0 0;
  }

  /* ------------------------------ convite -------------------------------- */

  .e-det-convite {
    display: grid;
    justify-items: center;
    gap: calc(var(--cel) * 0.3);
    margin-top: calc(var(--cel) * 1.2);
    padding: calc(var(--cel) * 0.9) 0;
    border-top: 1px solid var(--color-linha);
    text-align: center;
  }

  .e-det-convite-lid {
    margin: 0;
    max-width: 46ch;
    color: var(--color-cinza);
  }

  .e-det-convite h2 {
    margin: 0;
  }

  /* ------------------------------ chrome/rail ---------------------------- */

  /* halo da cor do papel: o nav fixo flutua por cima da faixa escura */
  :global(.e-det .e-nav) {
    text-shadow:
      0 1px 2px var(--color-papel),
      0 0 14px var(--color-papel);
  }

  :global(.e-det .e-selo) {
    filter: drop-shadow(0 1px 2px var(--color-papel)) drop-shadow(0 0 10px var(--color-papel));
  }

  .e-det-rail {
    position: absolute;
    left: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--cel) * 0.3);
    width: clamp(74px, 8vw, 108px);
    text-shadow:
      0 1px 2px var(--color-papel),
      0 0 14px var(--color-papel);
  }

  .e-det-rail > * {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-decoration: none;
    color: inherit;
    transition: color 0.3s var(--curva);
  }

  .e-det-rail a:hover {
    color: var(--color-terracota);
  }

  .e-det-rail-atual {
    color: var(--color-cinza);
  }

  /* ----------------------------- responsivo ------------------------------ */

  @media (max-width: 1023px) {
    .e-outros-grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .e-det {
      padding-inline: calc(var(--cel) * 0.42);
    }

    .e-det-topo {
      margin-left: 0;
      padding-right: 0;
      padding-top: calc(var(--cel) * 1.05);
    }

    .e-det-topo .e-det-h1 {
      font-size: clamp(46px, 13vw, var(--h1));
    }

    .e-det-grade {
      grid-template-columns: minmax(0, 1fr);
    }

    .e-det-painel {
      position: static;
      border-left: 0;
      border-top: 1px solid var(--color-linha);
      padding-left: 0;
      padding-top: calc(var(--cel) * 0.5);
      margin-top: calc(var(--cel) * 0.35);
    }

    .e-det-plantas-grade {
      grid-template-columns: minmax(0, 1fr);
    }

    .e-det-faixa {
      margin-inline: calc(var(--cel) * -0.42);
    }

    .e-det-faixa-lista {
      left: 0;
      right: 0;
      top: auto;
      bottom: calc(var(--cel) * 0.7);
      transform: none;
      padding-inline: calc(var(--cel) * 0.42);
      border-left: 0;
    }

    .e-det-faixa-lista li {
      font-size: clamp(26px, 7vw, var(--h5));
    }

    .e-outros-grade {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
