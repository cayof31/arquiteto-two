---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/midia/Foto.astro';
import Galeria from '../../components/projetos/Galeria.astro';
import { site } from '../../config/site';
import { fichaTrilha } from '../../lib/seo';

export async function getStaticPaths() {
  const obras = await getCollection('projetos');
  return obras.map((obra) => ({
    params: { slug: obra.id },
    props: { obra },
  }));
}

const { obra } = Astro.props;
const { titulo, local, ano, area, descricao, categoria, materiais, capa, altCapa, galeria, plantas, fonte } =
  obra.data;
const urlSite = Astro.site?.href.replace(/\/$/, '') ?? '';
---

<Base
  titulo={`${titulo} | ${site.nome}`}
  descricao={descricao}
  estruturados={[
    fichaTrilha([
      { nome: 'Início', url: urlSite },
      { nome: 'Projetos', url: `${urlSite}/projetos` },
      { nome: titulo, url: `${urlSite}/projetos/${obra.id}` },
    ]),
  ]}
>
  <article>
    <div class="relative h-[50vh] min-h-[320px] w-full overflow-hidden">
      <Foto src={capa} alt={altCapa} sizes="100vw" prioridade />
    </div>

    <header class="mx-auto max-w-3xl px-5 py-14 md:py-20">
      <p class="rotulo text-terracota">{categoria}</p>
      <h1 class="mt-3 font-titulo text-4xl md:text-6xl">{titulo}</h1>
      <p class="mt-4 text-cinza">
        {local} · {ano} · {area} m²
      </p>
      <p class="mt-8 leading-relaxed text-cinza">{descricao}</p>
    </header>

    <div class="mx-auto max-w-5xl px-5">
      <Galeria imagens={galeria} titulo={titulo} />
    </div>

    {
      plantas.length > 0 && (
        <section class="mx-auto max-w-5xl px-5 py-16">
          <h2 class="font-titulo text-3xl">Plantas</h2>
          <ul class="mt-8 grid gap-6 md:grid-cols-2">
            {plantas.map((planta, indice) => (
              <li class="min-h-64 overflow-hidden border border-linha bg-white p-4">
                <Foto
                  src={planta}
                  alt={`Planta ${indice + 1} — ${titulo}`}
                  sizes="(min-width: 768px) 40vw, 100vw"
                  classe="object-contain max-h-[28rem] w-full"
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mx-auto max-w-3xl px-5 py-16">
      <h2 class="font-titulo text-3xl">Ficha técnica</h2>
      <dl class="mt-8 grid gap-4 text-sm">
        <div class="flex justify-between gap-6 border-b border-linha py-3">
          <dt class="text-cinza">Área</dt>
          <dd>{area} m²</dd>
        </div>
        <div class="flex justify-between gap-6 border-b border-linha py-3">
          <dt class="text-cinza">Local</dt>
          <dd class="text-right">{local}</dd>
        </div>
        <div class="flex justify-between gap-6 border-b border-linha py-3">
          <dt class="text-cinza">Ano</dt>
          <dd>{ano}</dd>
        </div>
        <div class="border-b border-linha py-3">
          <dt class="text-cinza">Materiais</dt>
          <dd class="mt-2">{materiais.join(' · ')}</dd>
        </div>
      </dl>
      <p class="mt-8 text-sm text-cinza">
        Fonte:
        <a class="text-tinta underline-offset-2 hover:underline" href={fonte.url} target="_blank" rel="noopener">
          {fonte.nome}
        </a>
      </p>
      <p class="mt-10">
        <a href="/projetos" class="rotulo text-terracota underline-offset-4 hover:underline">
          Voltar aos projetos
        </a>
      </p>
    </section>
  </article>
</Base>
