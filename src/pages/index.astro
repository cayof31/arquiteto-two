---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FaixaHorizontal from '../components/home/FaixaHorizontal.astro';
import Hero from '../components/home/Hero.astro';
import PainelCheio from '../components/home/PainelCheio.astro';
import Sobre from '../components/home/Sobre.astro';
import Escritorio from '../components/home/Escritorio.astro';
import ObrasDestaque from '../components/home/ObrasDestaque.astro';
import ObraPainel from '../components/home/ObraPainel.astro';
import Contato from '../components/home/Contato.astro';
import { site } from '../config/site';
import { fichaEscritorio, fichaPessoa } from '../lib/seo';
import { obrasDestaque } from '../lib/projetos';

const todas = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
const destaques = obrasDestaque(todas).sort((a, b) => a.data.ordem - b.data.ordem);
const urlSite = Astro.site?.href.replace(/\/$/, '') ?? '';

// Obras usadas como intervalos visuais entre os blocos de texto.
const obraPorId = (id: string) => todas.find((obra) => obra.id === id);
const armazem = obraPorId('armazem-medellin');
const drHouse = obraPorId('dr-house');
---

<Base
  titulo={`${site.arquiteta} — ${site.nome} | Site para arquiteto`}
  descricao={site.descricaoCurta}
  estruturados={[fichaPessoa(urlSite), fichaEscritorio(urlSite)]}
  rodape={false}
>
  <FaixaHorizontal>
    <Hero />

    <PainelCheio
      src="suzana/atelier.jpg"
      alt="Interior do ateliê do studio, com circulação longa e marcenaria escura"
      legenda="O ateliê · Vila Madalena, São Paulo"
      detalhe="Maquete, planta e conversa ocupam o mesmo lugar."
      prioridade
    />

    <Sobre />
    <Escritorio />

    {
      armazem && (
        <PainelCheio
          src={armazem.data.capa}
          alt={armazem.data.altCapa}
          legenda="Obras além do residencial"
          detalhe={`${armazem.data.titulo} · ${armazem.data.local}, ${armazem.data.ano}`}
        />
      )
    }

    <ObrasDestaque obras={todas} />

    {
      destaques.map((obra, indice) => (
        <Fragment>
          <PainelCheio
            src={obra.data.capa}
            alt={obra.data.altCapa}
            legenda={`${obra.data.categoria} · ${obra.data.local}, ${obra.data.ano}`}
            detalhe={obra.data.titulo}
          />
          <ObraPainel obra={obra} indice={indice + 1} />
        </Fragment>
      ))
    }

    {
      drHouse && (
        <PainelCheio
          src={drHouse.data.capa}
          alt={drHouse.data.altCapa}
          legenda={`${drHouse.data.categoria} · ${drHouse.data.local}, ${drHouse.data.ano}`}
          detalhe={drHouse.data.titulo}
        />
      )
    }

    <Contato />
  </FaixaHorizontal>
</Base>

<style is:global>
  /* A home tem rolagem horizontal própria: a barra não aparece. */
  html {
    scrollbar-width: none;
  }

  html::-webkit-scrollbar {
    display: none;
  }
</style>
