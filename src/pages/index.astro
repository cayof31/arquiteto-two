---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/era.css';
import Hero from '../components/era/Hero.astro';
import Motivos from '../components/era/Motivos.astro';
import Manifesto from '../components/era/Manifesto.astro';
import Cifra from '../components/era/Cifra.astro';
import Numeros from '../components/era/Numeros.astro';
import Conceito from '../components/era/Conceito.astro';
import Processo from '../components/era/Processo.astro';
import SecaoHorizontal from '../components/era/SecaoHorizontal.astro';
import ContatoEra from '../components/era/ContatoEra.astro';
import Moldura from '../components/era/Moldura.astro';
import Selo from '../components/era/Selo.astro';
import Navegacao from '../components/era/Navegacao.astro';
import Trilho from '../components/era/Trilho.astro';
import Motor from '../components/era/Motor.astro';
import { site } from '../config/site';
import { fichaEscritorio, fichaPessoa } from '../lib/seo';

const todas = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
const urlSite = Astro.site?.href.replace(/\/$/, '') ?? '';
---

<Base
  titulo={`${site.arquiteta} — ${site.nome} | Site para arquiteto`}
  descricao={site.descricaoCurta}
  estruturados={[fichaPessoa(urlSite), fichaEscritorio(urlSite)]}
  rodape={false}
  cabecalho="mobile"
>
  <div class="pagina-era">
    <Hero />
    <Motivos />
    <Manifesto />
    <Cifra />

    <SecaoHorizontal
      obras={todas}
      intro={{
        // Foto clara: o título gigante passa por cima do quadro e precisa de contraste.
        src: 'projetos/casa-praca/capa.jpg',
        alt: 'Casa com pátios e vegetação, vista da sala para o quintal',
      }}
    />

    <Conceito />

    <ContatoEra />

    <div class="e-chrome">
      <Moldura />
      <Selo />
      <Navegacao />
      <Trilho />
    </div>

    <Motor />
  </div>
</Base>

<style is:global>
  html {
    /* scrollbar-width: none; */
  }

  html::-webkit-scrollbar {
    /* display: none; */
  }
</style>
