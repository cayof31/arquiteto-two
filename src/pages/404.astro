---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base titulo={`Página não encontrada | ${site.nome}`} descricao="A página que você procura não existe.">
  <section class="mx-auto max-w-xl px-5 py-28 text-center">
    <p class="rotulo text-cinza">Erro 404</p>
    <h1 class="mt-3 font-titulo text-4xl">Não encontramos esta página</h1>
    <p class="mt-5 text-sm leading-relaxed text-cinza sm:text-base">
      O endereço pode ter mudado. Volte ao início ou veja o portfólio de obras.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rotulo border border-tinta px-6 py-3 hover:bg-tinta hover:text-papel">
        Ir para o início
      </a>
      <a href="/projetos" class="rotulo bg-terracota px-6 py-3 text-papel hover:opacity-90">
        Ver projetos
      </a>
    </div>
  </section>
</Base>
