---
import Foto from '../midia/Foto.astro';

interface Props {
  imagens: string[];
  titulo: string;
}

const { imagens, titulo } = Astro.props;
---

<ul class="grid gap-3 sm:grid-cols-2">
  {
    imagens.map((imagem, indice) => (
      <li class:list={['overflow-hidden', indice === 0 ? 'sm:col-span-2 aspect-[16/9]' : 'aspect-[4/3]']}>
        <Foto
          src={imagem}
          alt={`${titulo} — foto ${indice + 1}`}
          sizes={indice === 0 ? '100vw' : '(min-width: 640px) 50vw, 100vw'}
        />
      </li>
    ))
  }
</ul>
