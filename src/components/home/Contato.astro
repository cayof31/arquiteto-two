---
import { site, mensagemWhatsapp } from '../../config/site';
import { linkWhatsapp } from '../../lib/whatsapp';

const whatsapp = linkWhatsapp(mensagemWhatsapp);
---

<section id="contato" class="border-t border-linha">
  <div class="mx-auto max-w-3xl px-5 py-20 text-center md:py-28">
    <p class="rotulo text-terracota">Contato</p>
    <h2 class="mt-3 font-titulo text-4xl md:text-5xl">Vamos conversar sobre o seu projeto</h2>
    <p class="mx-auto mt-6 max-w-prose leading-relaxed text-cinza">
      O studio atende de {site.cidade}. Mande uma mensagem e contamos como trabalhamos, prazos e o primeiro encontro.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener"
        class="rotulo bg-terracota px-6 py-3 text-papel transition hover:opacity-90"
      >
        WhatsApp {site.telefoneExibicao}
      </a>
      <a
        href={`mailto:${site.email}`}
        class="rotulo border border-tinta px-6 py-3 transition hover:bg-tinta hover:text-papel"
      >
        {site.email}
      </a>
    </div>
  </div>
</section>
