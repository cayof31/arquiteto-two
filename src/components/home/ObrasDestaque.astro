---
import type { CollectionEntry } from 'astro:content';
import ObraCard from '../projetos/ObraCard.astro';

interface Props {
  obras: CollectionEntry<'projetos'>[];
}

const { obras } = Astro.props;
---

<section id="projetos" class="border-t border-linha">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="rotulo text-terracota">Portfólio</p>
        <h2 class="mt-3 font-titulo text-4xl md:text-5xl">Obras em destaque</h2>
      </div>
      <a href="/projetos" class="rotulo text-terracota underline-offset-4 hover:underline">
        Ver todas as obras
      </a>
    </div>
    <ul class="mt-12 grid gap-10 md:grid-cols-3">
      {
        obras.map((obra) => (
          <li>
            <ObraCard obra={obra} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
