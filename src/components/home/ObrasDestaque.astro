---
import type { CollectionEntry } from 'astro:content';
import Foto from '../midia/Foto.astro';

interface Props {
  obras: CollectionEntry<'projetos'>[];
}

const { obras } = Astro.props;
---

<section id="projetos" data-painel class="painel painel-texto md:w-[min(96vw,1380px)]">
  <div class="grid w-full gap-8">
    <div class="grid gap-5 md:grid-cols-[1.05fr_0.95fr] md:items-end md:gap-12">
      <div>
        <p class="rotulo text-terracota" data-revelar>Portfólio</p>
        <h2 class="mt-3 text-[clamp(2rem,5.6vh,3.4rem)] leading-[1.05]" data-revelar style="--atraso:80ms">
          Obras que traduzem o nosso modo de construir
        </h2>
      </div>
      <div>
        <p
          class="max-w-prose text-[clamp(0.95rem,2vh,1.0625rem)] leading-relaxed text-cinza"
          data-revelar
          style="--atraso:160ms"
        >
          De casas em lotes estreitos a villas na selva: cada projeto parte do terreno, da luz e da rotina de quem
          vai ocupar o espaço.
        </p>
        <a
          href="/projetos"
          class="rotulo mt-4 inline-flex items-center gap-2 text-terracota underline-offset-4 hover:underline"
          data-revelar
          style="--atraso:240ms"
        >
          Ver todas as obras <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5 md:gap-5">
      {
        obras.map((obra, indice) => (
          <li data-revelar style={`--atraso:${300 + indice * 80}ms`}>
            <a href={`/projetos/${obra.id}`} class="group block">
              <div class="aspect-[4/3] overflow-hidden">
                <Foto
                  src={obra.data.capa}
                  alt={obra.data.altCapa}
                  sizes="(min-width: 768px) 17vw, 45vw"
                  classe="object-cover transition duration-500 group-hover:scale-[1.04]"
                />
              </div>
              <p class="rotulo mt-2 text-tinta transition group-hover:text-terracota">{obra.data.titulo}</p>
              <p class="mt-1 text-xs text-cinza">
                {obra.data.local} · {obra.data.ano}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
