---
import { site, mensagemWhatsapp } from '../../config/site';
import { linkWhatsapp } from '../../lib/whatsapp';
import Foto from '../midia/Foto.astro';

const whatsapp = linkWhatsapp(mensagemWhatsapp);
---

<section class="mx-auto grid min-h-[calc(100dvh-4.5rem)] max-w-6xl items-center gap-10 px-5 py-12 md:grid-cols-2 md:gap-16 md:py-16">
  <div>
    <p class="rotulo text-terracota">{site.cargo} · {site.cidade}</p>
    <h1 class="mt-4 font-titulo text-5xl leading-[0.95] sm:text-6xl lg:text-7xl">
      {site.arquiteta}
    </h1>
    <p class="mt-3 font-titulo text-2xl text-cinza italic sm:text-3xl">{site.nome}</p>
    <p class="mt-8 max-w-md text-lg leading-relaxed text-cinza">
      {site.manifesto}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener"
        class="rotulo bg-terracota px-6 py-3 text-papel transition hover:opacity-90"
      >
        Conversar no WhatsApp
      </a>
      <a href="#projetos" class="rotulo border border-tinta px-6 py-3 transition hover:bg-tinta hover:text-papel">
        Ver obras
      </a>
    </div>
  </div>

  <div class="relative aspect-[3/4] w-full overflow-hidden md:aspect-[4/5]">
    <Foto
      src="suzana/retrato.jpg"
      alt={`${site.arquiteta}, arquiteta do ${site.nome}`}
      sizes="(min-width: 768px) 45vw, 100vw"
      prioridade
    />
  </div>
</section>
