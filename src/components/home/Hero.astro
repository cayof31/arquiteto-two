---
import { site, mensagemWhatsapp } from '../../config/site';
import { linkWhatsapp } from '../../lib/whatsapp';
import Foto from '../midia/Foto.astro';

const whatsapp = linkWhatsapp(mensagemWhatsapp);
---

<section id="inicio" data-painel class="painel painel-texto md:w-[min(94vw,1240px)]">
  <div class="grid w-full items-center gap-9 md:grid-cols-[1.05fr_0.78fr] md:gap-16">
    <div>
      <p class="rotulo text-terracota" data-revelar>{site.cargo} · {site.cidade}</p>
      <h1
        class="mt-4 font-titulo text-[clamp(2.75rem,8vh,5rem)] leading-[0.95]"
        data-revelar
        style="--atraso:80ms"
      >
        {site.arquiteta}
      </h1>
      <p
        class="mt-2 font-titulo text-[clamp(1.375rem,3.4vh,2.125rem)] italic text-cinza"
        data-revelar
        style="--atraso:150ms"
      >
        {site.nome}
      </p>
      <p
        class="mt-6 max-w-md text-[clamp(1rem,2.1vh,1.125rem)] leading-relaxed text-cinza"
        data-revelar
        style="--atraso:230ms"
      >
        {site.manifesto}
      </p>
      <div class="mt-8 flex flex-wrap gap-3" data-revelar style="--atraso:310ms">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener"
          class="rotulo bg-terracota px-6 py-3 text-papel transition hover:opacity-90"
        >
          Conversar no WhatsApp
        </a>
        <a href="#projetos" class="rotulo border border-tinta px-6 py-3 transition hover:bg-tinta hover:text-papel">
          Ver obras
        </a>
      </div>
      <p class="rotulo mt-10 hidden items-center gap-3 text-cinza md:flex" data-revelar style="--atraso:520ms">
        Role para avançar
        <span class="seta" aria-hidden="true">→</span>
      </p>
    </div>

    <figure class="mx-auto w-full max-w-[320px] md:mx-0 md:max-w-[380px]">
      <div class="aspect-[3/4] overflow-hidden" data-revelar="foto" style="--atraso:260ms">
        <Foto
          src="suzana/retrato.jpg"
          alt={`${site.arquiteta}, ${site.cargo.toLowerCase()} do ${site.nome}`}
          sizes="(min-width: 768px) 26vw, 80vw"
          prioridade
        />
      </div>
      <figcaption class="rotulo mt-3 text-cinza" data-revelar style="--atraso:380ms">
        {site.arquiteta} · {site.cargo}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .seta {
    display: inline-block;
    animation: desliza 1.8s ease-in-out infinite;
  }

  @keyframes desliza {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(7px);
    }
  }
</style>
