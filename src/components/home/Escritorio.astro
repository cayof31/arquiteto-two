---
import { site } from '../../config/site';
import Foto from '../midia/Foto.astro';

const numeros = [
  { valor: `${site.anosAtuacao}+`, rotulo: 'Anos de atuação' },
  { valor: `${site.projetosRealizados}+`, rotulo: 'Projetos realizados' },
  { valor: site.cidade, rotulo: 'Base do studio' },
];
---

<section id="escritorio" class="border-t border-linha">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-2 md:items-center md:py-28">
    <div>
      <p class="rotulo text-terracota">O escritório</p>
      <h2 class="mt-3 font-titulo text-4xl leading-tight md:text-5xl">{site.nome}</h2>
      <p class="mt-6 max-w-prose leading-relaxed text-cinza">{site.filosofia}</p>
      <dl class="mt-10 grid grid-cols-3 gap-4">
        {
          numeros.map((item) => (
            <div>
              <dt class="text-xs text-cinza">{item.rotulo}</dt>
              <dd class="mt-1 font-titulo text-2xl md:text-3xl">{item.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="aspect-[4/3] overflow-hidden">
      <Foto src="suzana/atelier.jpg" alt={`Sala do ${site.nome}, sem pessoas`} sizes="(min-width: 768px) 45vw, 100vw" />
    </div>
  </div>
</section>
