---
import { site } from '../../config/site';
import Foto from '../midia/Foto.astro';
---

<section id="sobre" data-painel class="painel painel-texto md:w-[min(88vw,1120px)]">
  <div class="grid w-full items-center gap-9 md:grid-cols-[0.72fr_1fr] md:gap-16">
    <figure class="order-2 mx-auto w-full max-w-[300px] md:order-1 md:mx-0 md:max-w-[360px]">
      <div class="aspect-[3/4] overflow-hidden" data-revelar="foto" style="--atraso:200ms">
        <Foto
          src="suzana/sobre.jpg"
          alt={`${site.arquiteta} no ateliê, com um caderno sob o braço`}
          sizes="(min-width: 768px) 24vw, 78vw"
        />
      </div>
      <figcaption class="rotulo mt-3 text-cinza" data-revelar style="--atraso:320ms">
        Ateliê · {site.cidade}
      </figcaption>
    </figure>

    <div class="order-1 md:order-2">
      <p class="rotulo text-terracota" data-revelar>Sobre</p>
      <h2 class="mt-3 text-[clamp(2rem,5.4vh,3.25rem)] leading-[1.05]" data-revelar style="--atraso:80ms">
        A pessoa atrás do studio
      </h2>
      {
        site.bio.map((paragrafo, indice) => (
          <p
            class="mt-5 max-w-prose text-[clamp(0.95rem,2vh,1.0625rem)] leading-relaxed text-cinza"
            data-revelar
            style={`--atraso:${160 + indice * 90}ms`}
          >
            {paragrafo}
          </p>
        ))
      }
      <a
        href="#escritorio"
        class="rotulo mt-7 inline-flex items-center gap-2 text-terracota underline-offset-4 hover:underline"
        data-revelar
        style="--atraso:380ms"
      >
        Conhecer o escritório <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
