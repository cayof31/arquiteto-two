---
/**
 * Faixa horizontal da home.
 *
 * O scroll vertical da página move a faixa na horizontal 1:1 (sem barra de
 * rolagem visível). Em telas menores que 768px a faixa vira pilha vertical
 * e o script não inicializa.
 */
---

<div class="faixa-area">
  <div class="faixa-espacador" data-espacador aria-hidden="true"></div>

  <div class="faixa" data-faixa>
    <slot />
  </div>

  <div class="faixa-barra" aria-hidden="true">
    <span data-progresso></span>
  </div>

  <noscript>
    <style>
      .faixa {
        position: static !important;
        width: 100% !important;
        height: auto !important;
        flex-direction: column !important;
        transform: none !important;
      }
      .faixa-espacador,
      .faixa-barra {
        display: none !important;
      }
      [data-revelar] {
        opacity: 1 !important;
        transform: none !important;
        clip-path: none !important;
      }
    </style>
  </noscript>
</div>

<script>
  const faixa = document.querySelector<HTMLElement>('[data-faixa]');
  const espacador = document.querySelector<HTMLElement>('[data-espacador]');
  const barra = document.querySelector<HTMLElement>('[data-progresso]');

  if (faixa && espacador) {
    const desktop = window.matchMedia('(min-width: 768px)');
    const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cheios = Array.from(faixa.querySelectorAll<HTMLElement>('[data-cheio]'));

    let distancia = 0;
    let alvo = 0;
    let atual = 0;
    let quadro = 0;
    let primeiro = true;

    const limitar = (valor: number) => Math.min(Math.max(valor, 0), distancia);

    const pintar = () => {
      faixa.style.transform = `translate3d(${-atual.toFixed(2)}px, 0, 0)`;
      if (barra) barra.style.transform = `scaleX(${distancia > 0 ? atual / distancia : 0})`;

      if (semMovimento.matches) return;
      const largura = window.innerWidth;
      for (const painel of cheios) {
        const x = painel.offsetLeft - atual;
        if (x > largura || x + painel.offsetWidth < 0) continue;
        const desvio = x + painel.offsetWidth / 2 - largura / 2;
        const foto = painel.querySelector<HTMLElement>('[data-foto]');
        if (foto) foto.style.transform = `translate3d(${(desvio * 0.07).toFixed(2)}px, 0, 0) scale(1.12)`;
      }
    };

    const animar = () => {
      const diferenca = alvo - atual;
      if (Math.abs(diferenca) < 0.5) {
        atual = alvo;
        pintar();
        quadro = 0;
        return;
      }
      atual += diferenca * 0.14;
      pintar();
      quadro = requestAnimationFrame(animar);
    };

    const medir = () => {
      if (!desktop.matches) {
        distancia = 0;
        alvo = 0;
        atual = 0;
        espacador.style.height = '';
        faixa.style.transform = '';
        if (barra) barra.style.transform = 'scaleX(0)';
        return;
      }

      distancia = Math.max(0, faixa.scrollWidth - window.innerWidth);
      espacador.style.height = `${distancia + window.innerHeight}px`;
      alvo = limitar(window.scrollY);
      if (primeiro || semMovimento.matches) {
        atual = alvo;
        primeiro = false;
      }
      pintar();
    };

    const rolar = () => {
      if (!desktop.matches) return;
      alvo = limitar(window.scrollY);
      if (semMovimento.matches) {
        atual = alvo;
        pintar();
        return;
      }
      if (!quadro) quadro = requestAnimationFrame(animar);
    };

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (entrada.isIntersecting) {
            entrada.target.classList.add('visivel');
            observador.unobserve(entrada.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('[data-revelar]').forEach((el) => observador.observe(el));

    // Âncoras do menu apontam para painéis: levam a faixa até eles.
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      let url: URL;
      try {
        url = new URL(link.href, window.location.href);
      } catch {
        return;
      }
      if (!url.hash || url.pathname.replace(/\/$/, '') !== window.location.pathname.replace(/\/$/, '')) return;

      const destino = document.getElementById(url.hash.slice(1));
      if (!destino || !faixa.contains(destino)) return;

      link.addEventListener('click', (evento) => {
        if (!desktop.matches) return;
        evento.preventDefault();
        window.scrollTo({
          top: limitar(destino.offsetLeft),
          behavior: semMovimento.matches ? 'auto' : 'smooth',
        });
        history.replaceState(null, '', url.hash);
      });
    });

    window.addEventListener('scroll', rolar, { passive: true });
    window.addEventListener('resize', medir);
    desktop.addEventListener('change', medir);

    medir();

    if (window.location.hash && desktop.matches) {
      const destino = document.getElementById(window.location.hash.slice(1));
      if (destino) window.scrollTo(0, limitar(destino.offsetLeft));
    }
  }
</script>

<style>
  .faixa-espacador {
    height: 0;
  }

  .faixa {
    position: static;
    display: flex;
    width: 100%;
    height: auto;
    flex-direction: column;
  }

  .faixa-barra {
    display: none;
  }

  @media (min-width: 768px) {
    .faixa {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 0;
      width: max-content;
      height: 100%;
      flex-direction: row;
      overflow: hidden;
      transform: translate3d(0, 0, 0);
      will-change: transform;
    }

    .faixa-barra {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 30;
      display: block;
      height: 3px;
      background: color-mix(in srgb, var(--color-linha) 65%, transparent);
      pointer-events: none;
    }

    .faixa-barra span {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--color-terracota);
      transform: scaleX(0);
      transform-origin: left;
    }
  }
</style>
