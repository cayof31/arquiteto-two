---
/* Trilho esquerdo: número de progresso sobre um fio vertical + indicador de
   rolagem girado no rodapé (mesma leitura da referência). */
---

<div class="e-trilho" aria-hidden="true">
  <span class="e-l1" data-contador>00</span>
  <span class="e-trilho-fio"></span>
</div>

<div class="e-indicador e-l2" aria-hidden="true">
  <span>Role</span>
  <i class="e-indicador-fio"></i>
</div>
