---
/* Motor da home: revelações, parallax de imagens, número de progresso,
   troca de tema do chrome fixo e a faixa horizontal (sticky + lerp).
   Só roda nesta página; tudo é defensivo caso os elementos não existam. */
---

<script>
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const area = document.querySelector<HTMLElement>('[data-horizontal]');
  const faixa = area?.querySelector<HTMLElement>('[data-faixa]');
  const mq = window.matchMedia('(min-width: 768px)');
  const linhas = Array.from(document.querySelectorAll<HTMLElement>('[data-linha]'));
  const paralelos = Array.from(document.querySelectorAll<HTMLElement>('[data-paralelo]'));
  const contador = document.querySelector<HTMLElement>('[data-contador]');
  const anel = document.querySelector<HTMLElement>('.e-selo-anel');
  const chrome = document.querySelector<HTMLElement>('.e-chrome');
  const cabeca = document.querySelector<HTMLElement>('.cabecalho-mobile');
  const tematicos = Array.from(document.querySelectorAll<HTMLElement>('[data-tema]'));
  const heroi = document.querySelector<HTMLElement>('[data-heroi]');
  const telaHeroi = heroi?.querySelector<HTMLElement>('.e-hero-tela');
  const pinos = Array.from(document.querySelectorAll<HTMLElement>('[data-pino]'));

  const preso = (valor: number) => (valor < 0 ? 0 : valor > 1 ? 1 : valor);

  /* ---------------------------- abertura ---------------------------------- */
  /* A tela começa escura com a classe .e-abre; após o carregar, ela cai para
     o arco abrir (CSS) e o scroll fica travado até a porta terminar. Com
     movimento reduzido não há intro: .e-abre some no primeiro frame. */
  (() => {
    const el = document.querySelector<HTMLElement>('.e-hero-tela');
    if (!el) return;
    const tela: HTMLElement = el;

    if (semMovimento) {
      tela.classList.remove('e-abre');
      return;
    }

    document.documentElement.classList.add('e-abertura-ativa');
    let abriu = false;
    const abrir = () => {
      if (abriu) return;
      abriu = true;
      tela.classList.remove('e-abre');
      window.setTimeout(() => document.documentElement.classList.remove('e-abertura-ativa'), 2100);
    };

    if (document.readyState === 'complete') {
      window.setTimeout(abrir, 350);
    } else {
      window.addEventListener('load', () => window.setTimeout(abrir, 350), { once: true });
      /* teto de segurança: não prende a tela escura em rede lenta */
      window.setTimeout(abrir, 4000);
    }
  })();

  /* ----------------------- abas e pontos do hero -------------------------- */
  const abas = Array.from(document.querySelectorAll<HTMLButtonElement>('.e-aba'));
  const midias = Array.from(document.querySelectorAll<HTMLElement>('[data-midia]'));
  abas.forEach((aba) => {
    aba.addEventListener('click', () => {
      const valor = aba.dataset.valor;
      abas.forEach((outra) => {
        const ativa = outra === aba;
        outra.classList.toggle('is-ativa', ativa);
        outra.setAttribute('aria-pressed', String(ativa));
      });
      midias.forEach((midia) => midia.classList.toggle('is-ativa', midia.dataset.midia === valor));
    });
  });

  const pontos = Array.from(document.querySelectorAll<HTMLElement>('.hotspot'));
  const fechaPontos = () => {
    pontos.forEach((ponto) => {
      ponto.classList.remove('is-active');
      ponto.setAttribute('aria-expanded', 'false');
    });
  };
  pontos.forEach((ponto) => {
    const alterna = () => {
      const ativo = ponto.classList.contains('is-active');
      fechaPontos();
      if (!ativo) {
        ponto.classList.add('is-active');
        ponto.setAttribute('aria-expanded', 'true');
      }
    };
    ponto.addEventListener('click', (evento) => {
      evento.stopPropagation();
      alterna();
    });
    ponto.addEventListener('keydown', (evento) => {
      if (evento.key === 'Enter' || evento.key === ' ') {
        evento.preventDefault();
        alterna();
      }
      if (evento.key === 'Escape') fechaPontos();
    });
  });
  /* fecha o card aberto ao clicar em qualquer outro lugar da página */
  document.addEventListener('click', fechaPontos);

  /* ------------------------------- revelações ------------------------------ */
  const alvos = document.querySelectorAll<HTMLElement>('[data-entrada], [data-texto], [data-foto]');
  if (semMovimento) {
    alvos.forEach((el) => el.classList.add('visivel'));
  } else {
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (!entrada.isIntersecting) return;
          entrada.target.classList.add('visivel');
          observador.unobserve(entrada.target);
        });
      },
      /* Sem margem negativa: dentro da faixa fixada os elementos não sobem
         mais na tela — só deslizam na horizontal — e ficariam presos abaixo
         da linha de gatilho (mesma leitura de "entra na tela" da referência). */
      { rootMargin: '0px', threshold: 0 },
    );
    alvos.forEach((el) => observador.observe(el));
  }

  /* ------------------------------ contagem -------------------------------- */
  /* Números da faixa de dados: sobem de 0 ao valor real quando entram na
     tela. O gatilho é checado a cada frame do passo() (nada de observer, que
     pode ser perdido em rolagem muito rápida). Sem JS ou com movimento
     reduzido o valor final já está no HTML. */
  const contas = Array.from(document.querySelectorAll<HTMLElement>('[data-conta]'));
  const contasPendentes = new Set<HTMLElement>(contas);
  if (contas.length && !semMovimento) {
    contas.forEach((el) => {
      el.textContent = String(0).padStart(Number(el.dataset.contaPad ?? 0), '0');
    });
  }

  function contar(el: HTMLElement) {
    contasPendentes.delete(el);
    const alvo = Number(el.dataset.conta ?? 0);
    const pad = Number(el.dataset.contaPad ?? 0);
    const mostrar = (v: number) => {
      el.textContent = String(v).padStart(pad, '0');
    };
    if (semMovimento) {
      mostrar(alvo);
      return;
    }
    const inicio = performance.now();
    const duracao = 1500;
    const avancar = (agora: number) => {
      const k = Math.min(1, (agora - inicio) / duracao);
      const suave = 1 - Math.pow(1 - k, 3);
      mostrar(Math.round(alvo * suave));
      if (k < 1) requestAnimationFrame(avancar);
    };
    requestAnimationFrame(avancar);
  }

  function checarContas() {
    if (!contasPendentes.size) return;
    const vh = window.innerHeight;
    for (const el of contasPendentes) {
      const r = el.getBoundingClientRect();
      if (r.top < vh && r.bottom > 0) contar(el);
    }
  }

  /* --------------------------- faixa horizontal ---------------------------- */
  let altura = 0;
  let destino = 0;
  let atual = 0;
  let pendente = false;

  function aplicar() {
    if (faixa && mq.matches) {
      faixa.style.transform = `translate3d(${atual.toFixed(2)}px, 0, 0)`;
    }
  }

  function calcular() {
    if (!area || !faixa || !mq.matches) return;
    altura = faixa.scrollWidth;
    const percurso = altura - window.innerHeight;
    const p = percurso > 0 ? preso(-area.getBoundingClientRect().top / percurso) : 0;
    destino = -Math.max(0, altura - window.innerWidth) * p;
  }

  function parallax() {
    if (semMovimento) return;
    const vh = window.innerHeight;
    paralelos.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.bottom < -240 || r.top > vh + 240) return;
      const forca = Number(el.dataset.paralelo ?? 0);
      const meio = (r.top + r.height / 2 - vh / 2) / vh;
      el.style.transform = `translate3d(0, ${(-meio * forca).toFixed(1)}px, 0)`;
    });
  }

  /* Progresso total do scroll (0→1): com ele andam o contador 00–100 e o
     anel do selo — uma volta inteira do topo ao fim da página. */
  /* Progresso do hero fixado (0→1): publica em --p-heroi e o CSS faz o scrub
     (título que sobe, botão que sobe e cresce, parallax da foto). */
  function scrubHeroi() {
    if (!heroi || !telaHeroi) return;
    const percurso = heroi.offsetHeight - window.innerHeight;
    const p = percurso > 0 ? preso(-heroi.getBoundingClientRect().top / percurso) : 0;
    const valor = p.toFixed(4);
    if (telaHeroi.style.getPropertyValue('--p-heroi') !== valor) {
      telaHeroi.style.setProperty('--p-heroi', valor);
    }
  }

  /* Progresso de cada seção fixada (0→1): publica em --p-pin e move os
     elementos [data-scrub] no eixo Y pelo percurso do pin (fotos da seção
     Conceito). Com movimento reduzido os elementos ficam na posição base. */
  function scrubPinos() {
    if (semMovimento) return;
    for (const pino of pinos) {
      const percurso = pino.offsetHeight - window.innerHeight;
      if (percurso <= 0) continue;
      const p = preso(-pino.getBoundingClientRect().top / percurso);
      pino.style.setProperty('--p-pin', p.toFixed(4));
      pino.querySelectorAll<HTMLElement>('[data-scrub]').forEach((el) => {
        const forca = Number(el.dataset.scrub ?? 0);
        el.style.transform = `translate3d(0, ${((p - 0.5) * forca).toFixed(1)}px, 0)`;
      });
    }
  }

  function progresso() {
    const total = document.documentElement.scrollHeight - window.innerHeight;
    const p = total > 0 ? preso(window.scrollY / total) : 0;

    if (contador) {
      const texto = String(Math.round(p * 100)).padStart(2, '0');
      if (contador.textContent !== texto) contador.textContent = texto;
    }
    if (anel) {
      const giro = `rotate(${(p * 360).toFixed(2)}deg)`;
      if (anel.style.transform !== giro) anel.style.transform = giro;
    }
  }

  function tema() {
    if (!chrome && !cabeca) return;
    const amostra = 56;
    let claro = false;
    let cabecaClara = false;
    for (const secao of tematicos) {
      const r = secao.getBoundingClientRect();
      if (r.top <= amostra && r.bottom > amostra) {
        claro = secao.dataset.tema === 'claro';
        /* No arco o fundo é claro mesmo com texto branco: o menu precisa de tinta. */
        cabecaClara = secao.dataset.cabeca ? secao.dataset.cabeca === 'claro' : claro;
        break;
      }
    }
    chrome?.classList.toggle('e-chrome--claro', claro);
    cabeca?.classList.toggle('e-cabeca--clara', cabecaClara);
  }

  function passo() {
    pendente = false;
    if (mq.matches) {
      const dif = destino - atual;
      if (!semMovimento && Math.abs(dif) > 0.4) atual += dif * 0.16;
      else atual = destino;
      aplicar();
      if (atual !== destino) agendar();
    }
    // No desktop o trilho horizontal é quem move as linhas. No celular cada
    // slide é uma tela vertical: a mesma deriva acontece enquanto o slide
    // atravessa a viewport, com amplitude menor para não vazar da coluna.
    if (mq.matches) {
      const dist = Math.max(1, (altura || 1) - window.innerWidth);
      const p = preso(-atual / dist);
      linhas.forEach((linha) => {
        const f = Number(linha.dataset.linha ?? 0);
        if (f) linha.style.transform = `translate3d(${((p - 0.5) * f).toFixed(1)}px, 0, 0)`;
      });
    } else if (!semMovimento) {
      const vh = window.innerHeight;
      linhas.forEach((linha) => {
        const f = Number(linha.dataset.linha ?? 0);
        if (!f) return;
        const ancora = linha.closest('.e-slide') ?? linha;
        const r = ancora.getBoundingClientRect();
        const p = preso((vh - r.top) / (vh + r.height));
        linha.style.transform = `translate3d(${((p - 0.5) * f * 0.28).toFixed(1)}px, 0, 0)`;
      });
    }
    parallax();
    progresso();
    tema();
    scrubHeroi();
    scrubPinos();
    checarContas();
  }

  function agendar() {
    if (pendente) return;
    pendente = true;
    requestAnimationFrame(passo);
  }

  function medir() {
    if (!area || !faixa) return;
    if (!mq.matches) {
      area.style.height = '';
      faixa.style.transform = '';
      linhas.forEach((linha) => (linha.style.transform = ''));
      return;
    }
    altura = faixa.scrollWidth;
    area.style.height = `${altura}px`;
    calcular();
    atual = destino;
    aplicar();
  }

  window.addEventListener(
    'scroll',
    () => {
      calcular();
      agendar();
    },
    { passive: true },
  );
  window.addEventListener('resize', () => {
    medir();
    agendar();
  });
  window.addEventListener('load', () => {
    medir();
    agendar();
  });
  document.fonts?.ready.then(() => {
    medir();
    agendar();
  });

  medir();
  agendar();
</script>
