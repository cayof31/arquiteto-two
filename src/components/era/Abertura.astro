---
/* Camada de abertura do hero: tela escura com a marca central e os rótulos
   de canto, no formato da sequência inicial da referência. Sai para cima
   quando a porta abre (o clip-path do Hero) — o gatilho é a classe .e-abre
   na .e-hero-tela, removida pelo Motor. */
---

<div class="e-abertura" aria-hidden="true">
  <span class="e-abertura-marca">
    <span class="e-abertura-nome e-t-3">Suzana Loroff</span>
    <span class="e-abertura-scripto">Studio</span>
  </span>
  <span class="e-abertura-lado e-abertura-lado--e">Arquitetura</span>
  <span class="e-abertura-lado e-abertura-lado--d">São Paulo</span>
</div>

<style is:global>
  /* is:global porque as regras precisam enxergar a .e-hero-tela do Hero
     (componente pai) — seletor limitado ao prefixo e-abertura. */
  .e-abertura {
    position: absolute;
    inset: 0;
    z-index: 6;
    opacity: 1;
    transform: translateY(0);
    pointer-events: none;
    color: var(--color-papel);
    transition:
      opacity 0.9s var(--curva) 0.35s,
      transform 1.2s var(--curva) 0.3s;
  }

  /* sai para cima assim que o arco começa a abrir */
  .e-hero-tela:not(.e-abre) .e-abertura {
    opacity: 0;
    transform: translateY(-6vh);
  }

  .e-abertura-marca {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
    text-align: center;
    line-height: 1;
  }

  .e-abertura-nome {
    letter-spacing: 0.05em;
  }

  .e-abertura-scripto {
    font-family: var(--scripto);
    font-size: calc(var(--cel) * 0.86);
    line-height: 1.2;
  }

  .e-abertura-lado {
    position: absolute;
    bottom: calc(var(--cel) * 0.62);
    font-family: var(--display);
    font-size: var(--h4);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.9;
  }

  .e-abertura-lado--e {
    left: calc(var(--cel) * 0.9);
  }

  .e-abertura-lado--d {
    right: calc(var(--cel) * 0.9);
  }

  @media (max-width: 767px) {
    .e-abertura-lado {
      font-size: calc(var(--cel) * 0.5);
      bottom: calc(var(--cel) * 1);
      letter-spacing: 0.1em;
    }

    .e-abertura-lado--e {
      left: calc(var(--cel) * 0.5);
    }

    .e-abertura-lado--d {
      right: calc(var(--cel) * 0.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .e-abertura {
      display: none;
    }
  }
</style>
