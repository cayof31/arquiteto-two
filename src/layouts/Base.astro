---
import '../styles/global.css';
import Meta from '../components/seo/Meta.astro';
import DadosEstruturados from '../components/seo/DadosEstruturados.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  titulo: string;
  descricao: string;
  canonico?: string;
  imagemOg?: string;
  estruturados?: object[];
  /** A home tem o contato como último bloco: oculta o rodapé. */
  rodape?: boolean;
  /**
   * Cabeçalho global. `true` (padrão) mostra sempre, `false` oculta e
   * `'mobile'` mostra apenas abaixo do breakpoint — a home tem chrome próprio
   * no desktop e mantém o menu responsivo no celular.
   */
  cabecalho?: boolean | 'mobile';
}

const {
  titulo,
  descricao,
  canonico,
  imagemOg,
  estruturados = [],
  rodape = true,
  cabecalho = true,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="e-sem-js">
  <head>
    <script is:inline>
      document.documentElement.classList.remove('e-sem-js');
    </script>
    <Meta titulo={titulo} descricao={descricao} canonico={canonico} imagemOg={imagemOg} />
    <DadosEstruturados fichas={estruturados} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a
      href="#conteudo"
      class="rotulo sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-tinta focus:px-4 focus:py-2 focus:text-papel"
    >
      Pular para o conteúdo
    </a>
    {
      cabecalho === 'mobile' ? (
        <div class="cabecalho-mobile">
          <Header />
        </div>
      ) : (
        cabecalho && <Header />
      )
    }
    <main id="conteudo">
      <slot />
    </main>
    {rodape && <Footer />}
  </body>
</html>
